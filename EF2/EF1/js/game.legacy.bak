  'Firemaking',
])
  if (player.xp[k] === undefined) player.xp[k] = 0;
TREES.forEach((t) => {
  t.depletedUntil = 0;
  t.chops = 0;
});
let effects = [],
  projectiles = [],
  hazards = [],
  fires = [],
  lastActionAt = 0,
  actionDuration = 2400,
  lastRegion = '',
  skilling = null;
NPCS.forEach((n) => {
